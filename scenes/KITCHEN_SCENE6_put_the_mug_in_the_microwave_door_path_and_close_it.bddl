(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the mug in the microwave door path and close it)
  (:regions
    (microwave_init_region
      (:target kitchen_table)
      (:ranges ((-0.01 0.34 0.01 0.36)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (porcelain_mug_init_region
      (:target kitchen_table)
      (:ranges ((0.10 -0.20 0.15 -0.15)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (microwave_door_sweep_region
      (:target kitchen_table)
      (:ranges ((-0.30 0.00 -0.05 0.25)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (top_side (:target microwave_1))
    (heating_region (:target microwave_1))
  )

  (:fixtures
    kitchen_table - kitchen_table
    microwave_1 - microwave
  )

  (:objects
    porcelain_mug_1 - porcelain_mug
  )

  (:obj_of_interest
    porcelain_mug_1
    microwave_1
  )

  (:init
    (On microwave_1 kitchen_table_microwave_init_region)
    (On porcelain_mug_1 kitchen_table_porcelain_mug_init_region)
    (Open microwave_1)
  )

  (:goal
    (And
      (On porcelain_mug_1 kitchen_table_microwave_door_sweep_region)
      (Close microwave_1)
    )
  )
)
