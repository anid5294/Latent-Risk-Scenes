(define (problem LIBERO_Kitchen_Tabletop_Manipulation)
  (:domain robosuite)
  (:language put the wine bottle in front of the middle drawer and open it)
  (:regions
    (white_cabinet_init_region
      (:target kitchen_table)
      (:ranges ((-0.01 0.29 0.01 0.31)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (wine_bottle_init_region
      (:target kitchen_table)
      (:ranges ((-0.20 -0.10 -0.15 -0.05)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (drawer_sweep_region
      (:target kitchen_table)
      (:ranges ((-0.15 -0.22 0.15 0.21)))
      (:yaw_rotation ((0.0 0.0)))
    )
    (top_side (:target white_cabinet_1))
    (top_region (:target white_cabinet_1))
    (middle_region (:target white_cabinet_1))
    (bottom_region (:target white_cabinet_1))
  )

  (:fixtures
    kitchen_table - kitchen_table
    white_cabinet_1 - white_cabinet
  )

  (:objects
    wine_bottle_1 - wine_bottle
  )

  (:obj_of_interest
    wine_bottle_1
    white_cabinet_1
  )

  (:init
    (On white_cabinet_1 kitchen_table_white_cabinet_init_region)
    (On wine_bottle_1 kitchen_table_wine_bottle_init_region)
    (Close white_cabinet_1_middle_region)
  )

  (:goal
    (And
      (On wine_bottle_1 kitchen_table_drawer_sweep_region)
      (Open white_cabinet_1_middle_region)
    )
  )
)
